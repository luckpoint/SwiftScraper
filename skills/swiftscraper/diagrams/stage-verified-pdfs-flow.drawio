        <mxCell id="dry-output" value="移動は行わず、計画だけ出力&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;dryRun: true / movedCount は対象件数&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#77b996;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
