          <mxGeometry x="765" y="1847" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="move" value="親ディレクトリを作成して移動&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;mkdir(parents=True) → shutil.move()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#77b996;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="2020" width="600" height="100" as="geometry"/>
