          <mxGeometry x="765" y="955" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="output-safety" value="出力ルートと同期先の安全性を確認&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;outputDirectory を取得（あれば）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#33475b&quot;&gt;同期先ルートがダウンロード出力ディレクトリの内側なら拒否&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c7f93;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
