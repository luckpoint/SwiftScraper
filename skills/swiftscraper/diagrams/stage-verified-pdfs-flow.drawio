  <diagram id="stage-verified-pdfs-flow" name="stage_verified_pdfs">
    <mxGraphModel dx="1800" dy="2260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2260" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="stage_verified_pdfs.py の処理フロー&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#526273&quot;&gt;成功したPDFだけを安全に検証し、NotebookLM用のGoogle Drive同期フォルダへステージングする&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#152536;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="45" width="1000" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="result-json" value="結果JSON&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;result_json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#33475b&quot;&gt;--download-pdfs / pdf-downloads.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#8fb3e8;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="195" width="470" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="destination-root" value="同期先ルート&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;destination_root&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#33475b&quot;&gt;NotebookLM の同期フォルダ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#8fb3e8;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="665" y="195" width="470" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="options" value="実行名・オプション&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;--run-name / --dry-run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#33475b&quot;&gt;既定の実行名は run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#8fb3e8;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="195" width="470" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="parse" value="引数を解析し、パスを解決&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;parse_args() → result_json / destination_root / destination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c7f93;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="380" width="700" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="safe-run-name" value="run-name は安全な単一フォルダ名か？&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#33475b&quot;&gt;空文字・.・..・/・\\ を拒否&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8df;strokeColor=#e3b341;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="505" width="700" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="load" value="結果JSONを読み込む&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;load_result() → JSON.parse / UTF-8 read&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c7f93;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="650" width="700" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="enumerate" value="成功した outputPath を再帰的に列挙&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;iter_successful_paths() → success == true&lt;br&gt;unique_paths() → expanduser / resolve / 重複排除&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ebff;strokeColor=#a993df;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
