        <mxCell id="destination-exists" value="destination が&lt;br&gt;既に存在する？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8df;strokeColor=#e3b341;strokeWidth=2;fontColor=#152536;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="765" y="1310" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="validate-pdf" value="各 source をPDFとして検証&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#33475b&quot;&gt;存在する通常ファイル / 拡張子 .pdf / サイズ &amp;gt; 0&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:13px&quot;&gt;先頭5バイトが %PDF-&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#526273&quot;&gt;1件でも不正なら、移動処理を開始せず終了&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4f1;strokeColor=#e39a8f;strokeWidth=2;fontColor=#152536;fontSize=16;spacing=12;" vertex="1" parent="1">
